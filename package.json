{
  "pages": [
    {
      "path": "/",
      "data": {
        "collection": "courses",
        "filters": [
          {
            "field": "is_published",
            "operator": "==",
            "value": true
          }
        ],
        "fields": [
          "id",
          "title",
          "description",
          "thumbnail_url",
          "price"
        ]
      }
    },
    {
      "path": "/curso/:id",
      "data": {
        "collection": "courses",
        "filters": [
          {
            "field": "id",
            "operator": "==",
            "value": "{{url.id}}"
          }
        ],
        "fields": [
          "id",
          "title",
          "description",
          "thumbnail_url",
          "price"
        ],
        "relations": [
          {
            "collection": "modules",
            "field": "course_id",
            "target_field": "id",
            "fields": [
              "id",
              "title"
            ],
            "nested": {
              "collection": "lessons",
              "field": "module_id",
              "target_field": "id",
              "fields": [
                "id",
                "title"
              ]
            }
          }
        ]
      }
    },
    {
      "path": "/aula/:lesson_id",
      "data": {
        "collection": "lessons",
        "filters": [
          {
            "field": "id",
            "operator": "==",
            "value": "{{url.lesson_id}}"
          }
        ],
        "fields": [
          "id",
          "title",
          "description",
          "video_url",
          "module_id"
        ]
      }
    },
    {
      "path": "/meus-cursos",
      "data": {
        "collection": "enrollments",
        "filters": [
          {
            "field": "user_id",
            "operator": "==",
            "value": "{{auth.user.id}}"
          }
        ],
        "fields": [
          "course_id"
        ],
        "relations": [
          {
            "collection": "courses",
            "field": "id",
            "target_field": "course_id",
            "fields": [
              "id",
              "title",
              "thumbnail_url",
              "price"
            ]
          }
        ]
      }
    }
  ]
}